{
  "name": "quickfloorplan",
  "version": "0.1.0",
  "private": true,
  "description": "Sketch a flat's walls, openings and rooms and export a measured PDF. A measurement document, not a visualisation.",
  "license": "MIT",
  "author": "Maciej Nachtygal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhtgl/quickfloorplan.git"
  },
  "bugs": {
    "url": "https://github.com/nhtgl/quickfloorplan/issues"
  },
  "homepage": "https://github.com/nhtgl/quickfloorplan#readme",
  "keywords": [
    "floor-plan",
    "measurements",
    "pdf",
    "survey",
    "renovation"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run build && node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "jspdf": "^3.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svg2pdf.js": "^2.6.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^28.0.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
